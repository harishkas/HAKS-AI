# ==============================================================================
# HAKS Personal AI Assistant - Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# NEVER commit real API keys or sensitive passwords to version control.
# ==============================================================================

# Core System Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
HAKS_LOG_LEVEL=INFO

# Default AI Engine: 'local' (Ollama) or 'cloud'
HAKS_DEFAULT_ENGINE=local

# ------------------------------------------------------------------------------
# Local AI Engine (Ollama)
# ------------------------------------------------------------------------------
# Ollama local HTTP daemon address
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Recommended lightweight quantized models for Intel i5-7200U / 8 GB RAM:
# - llama3.2:1b (1.3 GB RAM - Fastest CPU inference)
# - qwen2.5:1.5b (1.6 GB RAM - Superior reasoning & multilingual)
# - llama3.2:3b (2.5 GB RAM - Upper limit for 8 GB RAM systems)
HAKS_LOCAL_MODEL=llama3.2:1b

# Local inference timeout in seconds
HAKS_AI_TIMEOUT=60.0

# ------------------------------------------------------------------------------
# Cloud AI Provider Adapters
# ------------------------------------------------------------------------------
# Active cloud provider: 'gemini', 'openai', or 'anthropic'
HAKS_CLOUD_PROVIDER=gemini

# API Keys can be configured in Windows Credential Manager via the HAKS UI
# (Settings -> Cloud AI) or provided as environment variable overrides below:
# HAKS_GEMINI_API_KEY=your_google_gemini_api_key_here
# HAKS_OPENAI_API_KEY=your_openai_api_key_here
# HAKS_ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here

# ------------------------------------------------------------------------------
# Voice & Audio Configuration (Phase 5)
# ------------------------------------------------------------------------------
HAKS_WAKE_PHRASE="Hey HAKS"
HAKS_PREFERRED_LANGUAGE=mixed
